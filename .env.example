# Copy to .env (git-ignored) and fill in the keys you use.

# OpenRouter: models with a provider prefix, e.g. anthropic/claude-sonnet-5.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Direct Anthropic API: bare Claude model ids, e.g. claude-opus-5-5.
# Get a key at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Only for user-scoped keys (sk-ant-usr-...): the workspace to bill.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# Optional
CTXAGENT_PORT=8765
